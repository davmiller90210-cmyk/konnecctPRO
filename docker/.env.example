# Public URL (no scheme). Used by Caddy for HTTPS and must match DNS A/AAAA record.
DOMAIN=app.konnecct.com

# Frappe site name — use the same value as DOMAIN for a public site so the Host header matches.
SITE_NAME=app.konnecct.com

# Initial password for Frappe user "Administrator" when the bench is first created (see init.sh).
# After the site exists, change it anytime: from docker/, run ./set-admin-password.sh 'NewStrongPassword'
ADMIN_PASSWORD=admin
